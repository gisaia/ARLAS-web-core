{
  "name": "arlas-web-core",
  "version": "29.1.0-dev0",
  "description": "Core Service Library for ARLAS Web App",
  "scripts": {
    "build-release": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -r patches dist/",
    "clean": "npm cache clear && rimraf -- dist",
    "lint": "eslint . --ext .ts",
    "postinstall": "patch-package",
    "license-check": "license-check-and-add check -f license-check-and-add.json",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gisaia/ARLAS-web-core.git"
  },
  "author": "gisaia",
  "license": "Apache-2.0",
  "dependencies": {
    "arlas-api": "29.0.0-rc1",
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "license-check-and-add": "^4.0.5",
    "node": "^24.10.1",
    "patch-package": "^8.0.1",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  },
  "bugs": {
    "url": "https://github.com/gisaia/ARLAS-web-core/issues"
  },
  "homepage": "https://github.com/gisaia/ARLAS-web-core/blob/master/README.md"
}
